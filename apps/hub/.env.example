# Environment Variables for Kaivalo Hub
# Copy this file to .env and fill in values

# WorkOS AuthKit
WORKOS_CLIENT_ID=your_client_id_here
WORKOS_API_KEY=your_api_key_here
# 64 hex chars = 32 bytes of entropy. Generate with: openssl rand -hex 32
WORKOS_COOKIE_PASSWORD=your_64_char_hex_string_here
# Separate 64 hex chars for signing browser-facing auth failure redirects.
AUTH_ERROR_SIGNING_SECRET=your_second_64_char_hex_string_here

# Local development (`npm run dev`)
WORKOS_REDIRECT_URI=http://localhost:5173/auth/callback
ORIGIN=http://localhost:5173

# Production example (keep WORKOS_REDIRECT_URI and ORIGIN on the same origin)
# WORKOS_REDIRECT_URI=https://hub.kaivalo.com/auth/callback
# ORIGIN=https://hub.kaivalo.com
# Optional: set when the WorkOS Authentication API and hosted AuthKit
# sign-in/sign-out pages use a custom hostname instead of api.workos.com.
# The current AuthKit SDK generates hosted auth URLs from this value.
# WORKOS_API_HOSTNAME=auth.kaivalo.com
# Optional compatibility check for legacy configs. If set, this must exactly
# match WORKOS_API_HOSTNAME. Split API/AuthKit hostnames are unsupported by the
# current AuthKit SDK and fail startup validation.
# WORKOS_AUTHKIT_HOSTNAME=auth.kaivalo.com

# Mandatory for production HTTPS origins: terminate TLS at a trusted proxy,
# set TRUST_X_FORWARDED_PROTO=true, and list only trusted proxy IPs in TRUSTED_PROXY_IPS.
# Also set ADDRESS_HEADER=x-forwarded-for and XFF_DEPTH to how many trusted
# proxy hops sit in front of the app so SvelteKit resolves the real client IP
# instead of the innermost proxy address.
# Configure the proxy to strip or overwrite any inbound x-forwarded-proto header
# before it forwards requests to the app.
# Keep false/default for local development and non-production HTTP-only environments.
TRUST_X_FORWARDED_PROTO=false
# Comma-separated proxy source IPs allowed to provide x-forwarded-proto values.
# If multiple proto hops still arrive, the app trusts the proxy-controlled hop
# nearest the app (the right-most value).
# Required when TRUST_X_FORWARDED_PROTO=true.
# TRUSTED_PROXY_IPS=203.0.113.10,2001:db8::10
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1

# Server binding — 127.0.0.1 for localhost only, 0.0.0.0 for all interfaces
HOST=127.0.0.1
PORT=3100

# Graceful shutdown deadline in milliseconds before force-exit on active requests.
# Must stay within Node's timer range (1-2147483647).
SHUTDOWN_TIMEOUT_MS=30000
