# Environment Variables for Kaivalo Hub
# Copy this file to .env and fill in values

# WorkOS AuthKit
WORKOS_CLIENT_ID=your_client_id_here
WORKOS_API_KEY=your_api_key_here
# 64 hex chars = 32 bytes of entropy. Generate with: openssl rand -hex 32
WORKOS_COOKIE_PASSWORD=your_64_char_hex_string_here

# Local development (`npm run dev`)
WORKOS_REDIRECT_URI=http://localhost:5173/auth/callback
ORIGIN=http://localhost:5173

# Production example (keep WORKOS_REDIRECT_URI and ORIGIN on the same origin)
# WORKOS_REDIRECT_URI=https://hub.kaivalo.com/auth/callback
# ORIGIN=https://hub.kaivalo.com

# Mandatory for production HTTPS origins: terminate TLS at a trusted proxy,
# set TRUST_X_FORWARDED_PROTO=true, and list only trusted proxy IPs in TRUSTED_PROXY_IPS.
# Keep false/default for local development and non-production HTTP-only environments.
TRUST_X_FORWARDED_PROTO=false
# Comma-separated proxy source IPs allowed to provide x-forwarded-proto values.
# Required when TRUST_X_FORWARDED_PROTO=true.
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Server binding — 127.0.0.1 for localhost only, 0.0.0.0 for all interfaces
HOST=127.0.0.1

# Graceful shutdown deadline in milliseconds before force-exit on active requests.
SHUTDOWN_TIMEOUT_MS=30000
