{
	"name": "@kaivalo/hub",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "node scripts/build-env.ts",
		"preview": "node scripts/preview.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"pretest": "svelte-kit sync",
		"test": "npm run test:unit && npm run test:build",
		"test:unit": "vitest run --exclude src/build.test.ts",
		"test:build": "vitest run src/build.test.ts",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@kaivalo/ui": "*",
		"@sveltejs/adapter-node": "^5.5.2",
		"@sveltejs/kit": "^2.20.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tailwindcss/vite": "^4.1.18",
		"@testing-library/svelte": "^5.2.8",
		"@types/node": "^25.3.5",
		"@vitest/ui": "^4.0.18",
		"jsdom": "^28.1.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.0.0",
		"vite": "^6.2.0",
		"vitest": "^4.0.18"
	},
	"type": "module",
	"dependencies": {
		"@workos/authkit-sveltekit": "^0.1.0",
		"lucide-svelte": "^0.563.0"
	}
}
